{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Periodic Table",
  "version": "0.1.0",
  "identifier": "com.local.periodictable",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Periodic Table",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "backgroundColor": "#12131a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
